# Supabase CLI scratch — link state, versions, pooler URL. Not secrets today, but
# machine-local and pointless in a shared repo. config.toml and migrations/ are the
# parts worth tracking, and they are not ignored.
supabase/.temp/

# state_sync.py staging files. They exist only between a CLI call and its cleanup,
# but a crashed run leaves one behind and a lock file in a public repo is noise at best.
.harvest.lock.*.json
_harvest_partial

# Last night's line-by-line check of every listing against its own price list. Runtime
# data, regenerated by run_daily.py step 4/7, and it carries 93 Dropbox FOLDER links --
# capability URLs that hand over a whole shared folder to anyone holding them. build_web
# has a whole assertion (_assert_no_folder_capability_urls) devoted to keeping those out
# of the published snapshot; they do not belong in git either.
data/sheet_check.json
# E-Agent login failure captures (sources/e_agent.py); uploaded as a run artifact, never committed
logs/
